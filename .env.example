# ═══════════════════════════════════════════════════════════════════
# Zenith Optima v2.1 — Environment Variables
# Copy to .env and fill in ALL values before running
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (REQUIRED — no in-memory fallback) ─────────────────────
# Local:      postgresql://sky:skypass@localhost:5432/skyplatform
# Docker:     postgresql://sky:skypass@postgres:5432/skyplatform
# Cloud:      postgresql://user:pass@cloud-host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://sky:skypass@localhost:5432/skyplatform

# Optional: point to a read replica for SELECT-heavy routes
# DATABASE_READ_URL=postgresql://sky:skypass@postgres-replica:5432/skyplatform

# ── Redis (REQUIRED for sessions, cache, Socket.io adapter) ─────────
# Local:  redis://localhost:6379
# Docker: redis://redis:6379
# Cloud:  rediss://user:pass@cloud-host:6380
REDIS_URL=redis://localhost:6379

# ── Kafka (Optional — in-memory EventEmitter fallback if not set) ────
# Local:  localhost:9092
# Docker: kafka:29092
KAFKA_BROKERS=localhost:9092

# ── Auth (CHANGE THESE — minimum 32 characters each) ────────────────
JWT_SECRET=skyplatform-super-secret-dev-key-2026-change-this
REFRESH_SECRET=skyplatform-refresh-secret-2026-change-this

# ── CORS (comma-separated allowed origins) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Demo Mode (random ops simulation every 2 min) ────────────────────
DEMO_MODE=true

# ── Database Pool (optional tuning) ─────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_READ_POOL_MAX=10
DB_SSL=false

# ── Email / SMTP (optional — for real booking notifications) ─────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password

# ── ML Service (Phase 3 — Python FastAPI inference) ─────────────────
# ML_SERVICE_URL=http://ml-service:8000
