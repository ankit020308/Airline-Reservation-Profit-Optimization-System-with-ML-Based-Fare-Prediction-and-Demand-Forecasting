{
  "name": "zenith-optima-ai",
  "version": "2.1.0",
  "description": "Airline Reservation Profit Optimization System — Horizontally Scalable Edition",
  "main": "server/index.js",
  "scripts": {
    "start":          "node server/index.js",
    "dev":            "nodemon server/index.js",
    "seed":           "node server/db/seed.js",
    "test":           "jest --runInBand",
    "docker:up":      "docker compose up -d --build",
    "docker:down":    "docker compose down",
    "docker:logs":    "docker compose logs -f app",
    "docker:scale":   "docker compose up -d --scale app=5",
    "k8s:apply":      "kubectl apply -f k8s/ -R",
    "k8s:delete":     "kubectl delete -f k8s/ -R",
    "health":         "curl -s http://localhost:3000/health | json_pp"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
